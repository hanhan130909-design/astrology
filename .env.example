# Environment Variables for Lunaxstar (星缘占星) Website
# Copy this file to .env.local and fill in your values

# ====================================
# REQUIRED: OpenAI API Key
# Get from: https://platform.openai.com/api-keys
# ====================================
OPENAI_API_KEY=sk-xxx

# ====================================
# REQUIRED: xingpan.vip API Token
# (Already configured in the project)
# ====================================
XINGPAN_API_TOKEN=989f888c4283e2cc2d8a5aa4af60932c

# ====================================
# REQUIRED: Firebase Configuration
# Used for: Google Login, User System, Social Features
# Get from: Firebase Console → Project Settings → Web App
# ====================================
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=xxx.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=xxx
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=xxx.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:xxxxx
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXX

# ====================================
# OPTIONAL: Local PyEphem Server
# For production, if using a local backend
# ====================================
# PSE_SERVER_URL=http://your-server:5000

# ====================================
# OPTIONAL: Custom OpenAI API Base URL
# For proxies or alternative endpoints
# ====================================
# OPENAI_API_BASE_URL=https://api.openai.com/v1
